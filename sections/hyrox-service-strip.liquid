{{ 'hyrox-service-strip.css' | asset_url | stylesheet_tag }}

{% if section.blocks.size > 0 %}
  <div class="hyrox-service-strip">
    <ul class="hyrox-service-strip__list" role="list" style="--service-count: {{ section.blocks.size }}">
      {% for block in section.blocks %}
        <li class="hyrox-service-strip__item" {{ block.shopify_attributes }}>
          {% if block.settings.link != blank %}<a class="hyrox-service-strip__link" href="{{ block.settings.link }}">{% endif %}
          <h2 class="hyrox-service-strip__title">{{ block.settings.title }}</h2>
          {% if block.settings.text != blank %}
            <p class="hyrox-service-strip__text">{{ block.settings.text }}</p>
          {% endif %}
          {% if block.settings.link != blank %}</a>{% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
{% endif %}

{% schema %}
{
  "name": "HYROX service strip",
  "tag": "section",
  "class": "hyrox-service-strip-section",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Service point",
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "15-day returns" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Try your equipment at home with our 15-day no-questions-asked return policy." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "HYROX service strip",
      "blocks": [
        { "type": "item", "settings": { "title": "15-day returns", "text": "Try your equipment at home with our 15-day no-questions-asked return policy." } },
        { "type": "item", "settings": { "title": "Expert support", "text": "A team with 20 years of experience building strength training equipment." } },
        { "type": "item", "settings": { "title": "U.S. shipping", "text": "Flat-rate on HYROX gear in the continental U.S. Free on select products." } }
      ]
    }
  ]
}
{% endschema %}
