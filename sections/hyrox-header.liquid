{{ 'hyrox-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hyrox-header.js' | asset_url }}" defer></script>

{% liquid
  assign menu_links = section.settings.menu.links
%}

<div class="hyrox-header">
  {% if section.settings.show_announcement and section.blocks.size > 0 %}
    <hyrox-announcement-slider
      class="hyrox-header__announcement"
      role="region"
      aria-label="Announcements"
      aria-live="polite"
      data-autoplay="{{ section.settings.announcement_autoplay }}"
      data-delay="{{ section.settings.announcement_speed }}"
    >
      {% for block in section.blocks %}
        {% if block.type == 'announcement' %}
          <div
            class="hyrox-header__announcement-slide{% if forloop.first %} is-active{% endif %}"
            data-announcement-slide
            aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
            {{ block.shopify_attributes }}
          >
            <span>{{ block.settings.text }}</span>
            {% if block.settings.link_label != blank %}
              <a href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.link_label }}</a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </hyrox-announcement-slider>
  {% endif %}

  <header id="header-component" class="hyrox-header__bar">
    <a class="hyrox-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 240 | image_tag: class: 'hyrox-header__logo-image', widths: '120, 180, 240', alt: shop.name }}
      {% else %}
        {{ section.settings.logo_text | default: shop.name }}
      {% endif %}
    </a>

    <nav class="hyrox-header__nav" aria-label="Primary navigation">
      {% for link in menu_links %}
        <a class="hyrox-header__nav-link" href="{{ link.url }}"{% if link.current or link.child_active %} aria-current="page"{% endif %}>{{ link.title }}</a>
      {% endfor %}
    </nav>

    <div class="hyrox-header__tools">
      {% if section.settings.show_search %}
        <a class="hyrox-header__icon-link" href="{{ routes.search_url }}" aria-label="Search">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.7" cy="10.7" r="6.7"/><path d="m15.7 15.7 4.8 4.8"/></svg>
        </a>
      {% endif %}
      {% if section.settings.show_account and shop.customer_accounts_enabled %}
        <a class="hyrox-header__icon-link" href="{{ routes.account_url }}" aria-label="Account">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7.4" r="3.5"/><path d="M5.8 20v-2.2c0-3.3 2.5-5.3 6.2-5.3s6.2 2 6.2 5.3V20"/></svg>
        </a>
      {% endif %}
      <a class="hyrox-header__cart" href="{{ routes.cart_url }}">
        <svg viewBox="0 0 24 26" aria-hidden="true"><rect x="3" y="5" width="18" height="18" rx="2"/><path d="M8 8V5a4 4 0 0 1 8 0v3"/></svg>
        <span>Cart ({{ cart.item_count }})</span>
      </a>
    </div>

    <details class="hyrox-header__mobile-menu">
      <summary class="hyrox-header__mobile-toggle" aria-label="Open menu">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </summary>
      <div class="hyrox-header__mobile-panel">
        {% for link in menu_links %}<a href="{{ link.url }}"{% if link.current or link.child_active %} aria-current="page"{% endif %}>{{ link.title }}</a>{% endfor %}
        <div class="hyrox-header__mobile-tools">
          {% if section.settings.show_search %}<a class="hyrox-header__icon-link" href="{{ routes.search_url }}" aria-label="Search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.7" cy="10.7" r="6.7"/><path d="m15.7 15.7 4.8 4.8"/></svg></a>{% endif %}
          {% if section.settings.show_account and shop.customer_accounts_enabled %}<a class="hyrox-header__icon-link" href="{{ routes.account_url }}" aria-label="Account"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="7.4" r="3.5"/><path d="M5.8 20v-2.2c0-3.3 2.5-5.3 6.2-5.3s6.2 2 6.2 5.3V20"/></svg></a>{% endif %}
          <a class="hyrox-header__cart" href="{{ routes.cart_url }}"><svg viewBox="0 0 24 26" aria-hidden="true"><rect x="3" y="5" width="18" height="18" rx="2"/><path d="M8 8V5a4 4 0 0 1 8 0v3"/></svg><span>({{ cart.item_count }})</span></a>
        </div>
      </div>
    </details>
  </header>
</div>

{% schema %}
{
  "name": "HYROX header",
  "class": "hyrox-header-section header-section",
  "settings": [
    { "type": "checkbox", "id": "show_announcement", "label": "Show announcement", "default": true },
    { "type": "checkbox", "id": "announcement_autoplay", "label": "Auto-rotate announcements", "default": true },
    { "type": "range", "id": "announcement_speed", "label": "Change announcement every", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 5 },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "HYROX" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show account", "default": true }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Fall race season is coming." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Train HYROX" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "HYROX header" }]
}
{% endschema %}
